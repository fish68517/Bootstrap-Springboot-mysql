/* 整体布局 */
.wrapper {
    display: flex;
    width: 100%;
    align-items: stretch;
}

/* 侧边栏样式 */
#sidebar {
    min-width: 250px;
    max-width: 250px;
    min-height: 100vh;
    background: #343a40;
    color: #fff;
    transition: all 0.3s;
}

#sidebar.active {
    margin-left: -250px;
}

/* 侧边栏头部 */
.sidebar-header {
    padding: 20px;
    background: #2c3136;
}

.sidebar-header h3 {
    color: #fff;
    margin: 0;
    font-size: 1.5rem;
}

/* 用户信息样式 */
.user-info {
    padding: 15px 0;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid #454d55;
}

.user-info i {
    font-size: 1.2rem;
}

/* 菜单项样式 */
#sidebar .components {
    padding: 20px 0;
}

#sidebar .components li a {
    padding: 10px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    text-decoration: none;
    transition: all 0.3s;
}

#sidebar .components li a:hover {
    background: #2c3136;
    color: #007bff;
}

#sidebar .components li.active a {
    background: #007bff;
    color: #fff;
}

#sidebar .components li a i {
    width: 20px;
    text-align: center;
}

/* 主要内容区域 */
#content {
    width: 100%;
    padding: 20px;
    min-height: 100vh;
    transition: all 0.3s;
    background: #f8f9fa;
}

/* 响应式设计 */
@media (max-width: 768px) {
    #sidebar {
        margin-left: -250px;
    }
    #sidebar.active {
        margin-left: 0;
    }
    #content {
        padding: 15px;
    }
}

/* 导航栏样式 */
.navbar {
    padding: 15px;
    background: #fff !important;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

#sidebarCollapse {
    background: #007bff;
    border: none;
}

/* 表格样式优化 */
.table {
    background: #fff;
    box-shadow: 0 0 10px rgba(0,0,0,0.05);
    border-radius: 4px;
}

.table thead th {
    background: #f8f9fa;
    border-bottom: 2px solid #dee2e6;
}

/* 按钮样式 */
.btn-primary {
    background: #007bff;
    border: none;
}

.btn-primary:hover {
    background: #0056b3;
}

/* 卡片样式 */
.card {
    box-shadow: 0 0 10px rgba(0,0,0,0.05);
    border: none;
    border-radius: 4px;
}

.card-title {
    color: #343a40;
    font-weight: 500;
}

.btn-edit-course {
    margin-right: 5px; /* 增加按钮之间的间距 */
}